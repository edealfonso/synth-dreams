  {
    "group": "2",
    "kind": "SQUARE",
    "image": "images/vignettes/mod-adsr.svg",
    "text1": {
      "es": "<p><strong>Ataque:</strong> tiempo hasta la pegada.</p>",
      "en": "<p><strong>Attack:</strong> time to the peak.</p>"
    },
    "text2": {
      "es": "<p><strong>Decaimiento:</strong> tiempo hasta el sostenido.</p>",
      "en": "<p><strong>Decay:</strong> time down to the sustain.</p>"
    },
    "text3": {
      "es": "<p><strong>Sostenido:</strong> nivel mientras pulsas.</p>",
      "en": "<p><strong>Sustain:</strong> level while you hold the key.</p>"
    },
    "text4": {
      "es": "<p><strong>Relajación:</strong> tiempo hasta el silencio.</p>",
      "en": "<p><strong>Release:</strong> time back to silence.</p>"
    }
  },
  {
    "group": "2",
    "kind": "SQUARE",
    "image": "images/vignettes/mod-filter.svg",
    "text1": {
      "es": "<p><strong>Frecuencia de corte:</strong> lo que queda por encima se apaga.</p>",
      "en": "<p><strong>Cutoff:</strong> everything above it fades away.</p>"
    },
    "text2": {
      "es": "<p><strong>Resonancia:</strong> un pico justo en el corte que hace silbar el sonido.</p>",
      "en": "<p><strong>Resonance:</strong> a peak right at the cutoff that makes the sound whistle.</p>"
    }
  },
  {
    "group": "2",
    "kind": "ROUND",
    "image": "images/vignettes/mod-lfo.svg",
    "text1": {
      "es": "<p><strong>LFO:</strong> una onda tan lenta que no se oye; mueve otros controles sola, como una mano invisible.</p>",
      "en": "<p><strong>LFO:</strong> a wave too slow to hear; it moves other controls by itself, like an invisible hand.</p>"
    }
  },
  {
    "group": "2",
    "kind": "ROUND",
    "image": "images/vignettes/mod-pitch.svg",
    "text1": {
      "es": "<p><strong>Afinación:</strong> sube o baja la nota por semitonos u octavas para darle otra presencia; el <em>finetune</em> la desafina un poco y le añade imperfección y matices.</p>",
      "en": "<p><strong>Pitch:</strong> moves the note up or down in semitones or octaves for a different presence; <em>fine-tune</em> detunes it slightly, adding imperfection and nuance.</p>"
    }
  }
]
