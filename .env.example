# Copy this file to .env and fill in the values. .env is not committed.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# Comma-separated hosts
# To open the site from a phone on the same wifi, add the computer's LAN IP and/or its .local name
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Trusted CSRF origins (prod only), comma-separated
DJANGO_CSRF_TRUSTED_ORIGINS=
# URL prefix when the site is served from a subpath (static export for GitHub Pages: /synth-dreams).
# Leave empty locally. Webpack reads it too, so build with the same value.
SITE_PREFIX=

# PostgreSQL (used by both the db container and Django)
POSTGRES_DB=synthdreams
POSTGRES_USER=synthdreams
POSTGRES_PASSWORD=synthdreams
POSTGRES_HOST=db
POSTGRES_PORT=5432
